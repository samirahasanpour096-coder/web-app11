{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app11",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "90d5225e-1005-46d3-801f-a0ab2966187b","database_name": "an" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "703e84bdb8da40b086571dd0bd4be690" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
